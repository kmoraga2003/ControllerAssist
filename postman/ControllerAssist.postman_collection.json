{
	"info": {
		"_postman_id": "controller-assist-quimica-v2",
		"name": "ControllerAssist - Sistema de Control de Asistencias (Empresa Química)",
		"description": "Colección completa de endpoints para evaluación de los requerimientos: CA-01, RE-01, RE-02, RE-03, GU-01, GU-02, GU-03 y AP-01.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Autenticación (CA-01)",
			"item": [
				{
					"name": "Login Administrador",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@quimica.cl\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Login Empleado",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"carlos.silva@quimica.cl\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Control de Asistencia (CA-01)",
			"item": [
				{
					"name": "Marcar Asistencia (Botón Entrada/Salida)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"employeeCode\": \"EMP-101\",\n  \"notes\": \"Marcación desde dispositivo o Postman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/attendances/punch",
							"host": ["{{baseUrl}}"],
							"path": ["api", "attendances", "punch"]
						}
					}
				},
				{
					"name": "Consultar Asistencia de Hoy de un Empleado",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/attendances/my-today/2",
							"host": ["{{baseUrl}}"],
							"path": ["api", "attendances", "my-today", "2"]
						}
					}
				},
				{
					"name": "Listar Asistencias de Hoy (General)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/attendances/today",
							"host": ["{{baseUrl}}"],
							"path": ["api", "attendances", "today"]
						}
					}
				}
			]
		},
		{
			"name": "3. Reportes Administrativos (RE-01, RE-02, RE-03)",
			"item": [
				{
					"name": "RE-01: Reporte de Atrasos (Post 09:30 AM)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/reports/late?startDate=2026-01-01&endDate=2026-12-31",
							"host": ["{{baseUrl}}"],
							"path": ["api", "reports", "late"],
							"query": [
								{ "key": "startDate", "value": "2026-01-01" },
								{ "key": "endDate", "value": "2026-12-31" }
							]
						}
					}
				},
				{
					"name": "RE-02: Reporte de Salidas Anticipadas (Antes 17:30 PM)",
